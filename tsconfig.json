{
  "compilerOptions": {
    "module": "commonjs",
    "target": "es2020",
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "declaration": true,
    "rootDir": "./src",
    "outDir": "./dist",
    "types": ["node"],
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist", "src/test-db", "src/integration", "src/**/*.test.ts", "src/**/*.tsx", "src/components/**", "src/auth-context.tsx", "src/icons.tsx", "src/root-layout.tsx", "src/service-worker.js", "app", "frontend"]
}