{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm ci --include=dev && npm --prefix frontend ci --include=dev",
  "buildCommand": "node scripts/audit-dependencies.mjs && npm test && tsc -p api/tsconfig.json && npm run frontend:build",
  "outputDirectory": "frontend/dist",
  "routes": [
    {
      "src": "/api/v1/(.*)",
      "dest": "/api/[...path].ts"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ],
  "git": {
    "deploymentEnabled": {
      "f1/project-scoped-cob-20261119": false
    }
  }
}
