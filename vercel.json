
{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm ci && npm --prefix frontend ci",
  "buildCommand": "tsc -p api/tsconfig.json && npm run frontend:build",
  "outputDirectory": "frontend/dist",
  "routes": [
    {
      "src": "/api/v1/(.*)",
      "dest": "/api/[...path].ts"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
